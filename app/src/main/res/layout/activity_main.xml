<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold" android:textColor="#F4F0E7" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/tagline" android:textSize="14sp" android:textColor="#A5ADBB" />
        <LinearLayout android:id="@+id/controls" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="440dp" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/control_eyebrow" android:textSize="11sp" android:letterSpacing="0.22" android:textColor="#CDBB91" />
            <FrameLayout android:layout_width="252dp" android:layout_height="252dp" android:layout_marginTop="28dp"
                android:background="@drawable/power_halo">
                <ImageButton android:id="@+id/auto_skip" android:layout_width="212dp" android:layout_height="212dp"
                    android:layout_gravity="center" android:background="@drawable/power_button" android:src="@drawable/ic_power"
                    android:tint="@color/power_icon" android:padding="73dp" android:scaleType="fitCenter"
                    android:contentDescription="@string/turn_on" />
            </FrameLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:gravity="center" android:textSize="27sp" android:textStyle="bold"
                android:textColor="#F4F0E7" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/status_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:textSize="15sp" android:textColor="#A5ADBB" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/privacy_footer" android:textSize="12sp" android:textColor="#A5ADBB" />
        <Button android:id="@+id/help" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="8dp" android:text="@string/help" android:textAllCaps="false" android:textColor="#DDC38A" />
    </LinearLayout>
</ScrollView>
